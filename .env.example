PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Optional voice provider key. Prefer `photon-codex auth set elevenlabs` on macOS.
ELEVENLABS_API_KEY=
PHOTON_CODEX_ALLOWED_SENDER=
# Optional. Defaults to ~/.config/photon-codex/workspace.
PHOTON_CODEX_CWD=
# Optional. Set only when normal Codex uses a non-default home.
CODEX_HOME=
# Optional. macOS prefers the executable bundled with the ChatGPT app.
PHOTON_CODEX_BIN=
