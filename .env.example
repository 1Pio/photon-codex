PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_CODEX_ALLOWED_SENDER=+15551234567
# Optional. Defaults to ~/.config/photon-codex/workspace.
PHOTON_CODEX_CWD=/absolute/path/to/the/workspace
# Optional. Values: light, medium, high, extra high, max. Default: medium.
PHOTON_CODEX_REASONING_EFFORT=medium
# Optional. Values: true, false. Default: true.
PHOTON_CODEX_FAST_MODE=true
